{
  "name": "@n-uf/papyrus-react",
  "version": "26.11.1",
  "description": "React components for the papyrus documents engine: content-free page and content blocks, the React-typed document registry and print styles",
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/papyrus.git",
    "directory": "packages/papyrus-react"
  },
  "homepage": "https://github.com/n-uf/papyrus#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "!src/**/*.stories.*",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__",
    "!src/**/__mocks__",
    "!src/**/*.config.*",
    "!src/**/test-setup.*",
    "!src/**/setup-tests.*",
    "!src/**/_agent"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./indicator": {
      "types": "./src/indicator/index.ts",
      "default": "./src/indicator/index.ts"
    },
    "./logo": {
      "types": "./src/logo/index.ts",
      "default": "./src/logo/index.ts"
    },
    "./file-list": {
      "types": "./src/file-list/index.ts",
      "default": "./src/file-list/index.ts"
    },
    "./containers": {
      "types": "./src/containers/index.ts",
      "default": "./src/containers/index.ts"
    },
    "./layout": {
      "types": "./src/layout/index.ts",
      "default": "./src/layout/index.ts"
    },
    "./typography": {
      "types": "./src/typography/index.ts",
      "default": "./src/typography/index.ts"
    },
    "./tables": {
      "types": "./src/tables/index.ts",
      "default": "./src/tables/index.ts"
    },
    "./lists": {
      "types": "./src/lists/index.ts",
      "default": "./src/lists/index.ts"
    },
    "./cards": {
      "types": "./src/cards/index.ts",
      "default": "./src/cards/index.ts"
    },
    "./styles": {
      "types": "./src/styles/index.ts",
      "default": "./src/styles/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./dossier": {
      "types": "./src/dossier/index.ts",
      "default": "./src/dossier/index.ts"
    },
    "./params": {
      "types": "./src/params/index.ts",
      "default": "./src/params/index.ts"
    },
    "./tailwind.css": "./src/styles/papyrus.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@n-uf/papyrus": "workspace:^",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@n-uf/eslint-config": "workspace:*",
    "@n-uf/typescript-config": "workspace:*",
    "@n-uf/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
