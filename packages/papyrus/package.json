{
  "name": "@n-uf/papyrus",
  "version": "0.3.3",
  "description": "Documents engine: content-free UI building blocks, document registry and PDF export for documents rendered as HTML and PDF",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/angiospermae.git",
    "directory": "packages/papyrus"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "src",
    "!src/**/*.stories.*",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__",
    "!src/**/__mocks__",
    "!src/**/*.config.*",
    "!src/**/test-setup.*",
    "!src/**/setup-tests.*",
    "!src/**/_agent"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "papyrus": "./src/pdf/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./indicator": {
      "types": "./src/indicator/index.ts",
      "default": "./src/indicator/index.ts"
    },
    "./logo": {
      "types": "./src/logo/index.ts",
      "default": "./src/logo/index.ts"
    },
    "./file-list": {
      "types": "./src/file-list/index.ts",
      "default": "./src/file-list/index.ts"
    },
    "./containers": {
      "types": "./src/containers/index.ts",
      "default": "./src/containers/index.ts"
    },
    "./layout": {
      "types": "./src/layout/index.ts",
      "default": "./src/layout/index.ts"
    },
    "./typography": {
      "types": "./src/typography/index.ts",
      "default": "./src/typography/index.ts"
    },
    "./tables": {
      "types": "./src/tables/index.ts",
      "default": "./src/tables/index.ts"
    },
    "./lists": {
      "types": "./src/lists/index.ts",
      "default": "./src/lists/index.ts"
    },
    "./cards": {
      "types": "./src/cards/index.ts",
      "default": "./src/cards/index.ts"
    },
    "./styles": {
      "types": "./src/styles/index.ts",
      "default": "./src/styles/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./dossier": {
      "types": "./src/dossier/index.ts",
      "default": "./src/dossier/index.ts"
    },
    "./params": {
      "types": "./src/params/index.ts",
      "default": "./src/params/index.ts"
    },
    "./pdf": {
      "types": "./src/pdf/index.d.ts",
      "default": "./src/pdf/index.js"
    },
    "./server": {
      "types": "./src/server/index.d.ts",
      "default": "./src/server/index.js"
    },
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.js"
    },
    "./tailwind.css": "./src/styles/papyrus.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "playwright": "^1.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@n-uf/eslint-config": "workspace:*",
    "@n-uf/typescript-config": "workspace:*",
    "@n-uf/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
