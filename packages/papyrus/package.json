{
  "name": "@finfactory/doc-ui",
  "version": "1.0.0",
  "private": false,
  "description": "Reusable UI components for documentation and printable PDF pages",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@finfactory/typescript-config": "workspace:*",
    "@types/node": "^25.0.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./indicator": {
      "types": "./src/indicator/index.ts",
      "default": "./src/indicator/index.ts"
    },
    "./logo": {
      "types": "./src/logo/index.ts",
      "default": "./src/logo/index.ts"
    },
    "./file-list": {
      "types": "./src/file-list/index.ts",
      "default": "./src/file-list/index.ts"
    },
    "./containers": {
      "types": "./src/containers/index.ts",
      "default": "./src/containers/index.ts"
    },
    "./layout": {
      "types": "./src/layout/index.ts",
      "default": "./src/layout/index.ts"
    },
    "./typography": {
      "types": "./src/typography/index.ts",
      "default": "./src/typography/index.ts"
    },
    "./tables": {
      "types": "./src/tables/index.ts",
      "default": "./src/tables/index.ts"
    },
    "./lists": {
      "types": "./src/lists/index.ts",
      "default": "./src/lists/index.ts"
    },
    "./cards": {
      "types": "./src/cards/index.ts",
      "default": "./src/cards/index.ts"
    },
    "./styles": {
      "types": "./src/styles/index.ts",
      "default": "./src/styles/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./dossier": {
      "types": "./src/dossier/index.ts",
      "default": "./src/dossier/index.ts"
    }
  }
}
