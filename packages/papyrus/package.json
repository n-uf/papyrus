{
  "name": "@n-uf/papyrus",
  "version": "0.3.4",
  "description": "Documents engine, framework-free: page contract, sheet sizes and print CSS, document registry, and PDF export for documents rendered as HTML and PDF",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/angiospermae.git",
    "directory": "packages/papyrus"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "src",
    "!src/**/*.stories.*",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__",
    "!src/**/__mocks__",
    "!src/**/*.config.*",
    "!src/**/test-setup.*",
    "!src/**/setup-tests.*",
    "!src/**/_agent"
  ],
  "main": "./src/core/index.js",
  "types": "./src/core/index.d.ts",
  "bin": {
    "papyrus": "./src/pdf/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./sheet-a4.css": "./src/core/sheet-a4.css",
    "./sheet-letter.css": "./src/core/sheet-letter.css",
    "./pdf": {
      "types": "./src/pdf/index.d.ts",
      "default": "./src/pdf/index.js"
    },
    "./server": {
      "types": "./src/server/index.d.ts",
      "default": "./src/server/index.js"
    },
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "gen:sheets": "node scripts/gen-sheet-css.js"
  },
  "peerDependencies": {
    "playwright": "^1.40.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@n-uf/eslint-config": "workspace:*",
    "@n-uf/typescript-config": "workspace:*",
    "@n-uf/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
