{
  "name": "@pdfized/doc-ui",
  "version": "1.0.7",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/pdfized/pdf-n-docs.git",
    "directory": "packages/doc-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Reusable UI components for documentation and printable PDF pages",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@pdfized/typescript-config": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./indicator": {
      "types": "./src/indicator/index.ts",
